{
  "name": "MDDocs",
  "short_name": "MDDocs",
  "description": "Open-source docs system built on mdui 2, Vue 3 and Markdown.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fef7ff",
  "theme_color": "#6750a4",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ]
}
